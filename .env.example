# Copy this file to `.env` for local development, and add the same names in
# Netlify: Site configuration > Environment variables.
# Only variables starting with PUBLIC_ are sent to the browser. Never put a
# Supabase service_role key here.

# Supabase project URL and the publishable (anon) key. The anon key is safe in
# the browser ONLY because row level security allows inserts and nothing else.
PUBLIC_SUPABASE_URL=https://YOUR-KITCHENANDALL-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Schema + table the quote form inserts into (see supabase/README.md).
PUBLIC_SUPABASE_SCHEMA=esquire
PUBLIC_SUPABASE_LEADS_TABLE=leads

# Google Tag Manager container, e.g. GTM-XXXXXXX. Leave empty until Lloyd creates it.
PUBLIC_GTM_ID=

# Meta Pixel ID (already live on the old site).
PUBLIC_META_PIXEL_ID=2429618624154084
