---
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { telLink } from '../lib/whatsapp';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo">Esquire<span class="accent">Diversity</span> LTD</a>
        <p>Interior design and construction company in Nairobi. Design, itemised quote, build and handover, managed by one team.</p>
        <address style="font-style: normal;">
          <a href={SITE.mapsUrl} target="_blank" rel="noopener">{SITE.address.street}, {SITE.address.city}, {SITE.address.countryName}, {SITE.address.postalCode}</a><br />
          <a href={telLink}>{SITE.phoneDisplay}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
      </div>
      <div>
        <h2>Services</h2>
        <ul>
          {services.map((s) => <li><a href={`/${s.id}`}>{s.data.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/about">About us</a></li>
          <li><a href="/get-quote">Get a quote</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      {/* TODO(esquire/Lloyd): add VVStudios website URL here if you want a proper credit link. */}
      <p>Website by VVStudios</p>
    </div>
  </div>
</footer>
