---
import { NAV, SITE } from '../data/site';
import { telLink, waLink } from '../lib/whatsapp';
import Icon from './Icon.astro';
import { cleanPath } from '../lib/path';
const current = cleanPath(Astro.url.pathname);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>Esquire<span>Diversity</span></a>
    <ul class="nav">
      {NAV.map((item) => (
        <li><a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <div class="header-cta">
      <a class="btn btn-call" href={telLink}><Icon name="phone" /><span>{SITE.phoneDisplay}</span></a>
      <a class="btn btn-dark" href="/get-quote">Get a quote</a>
      <details class="mobile-menu">
        <summary aria-label="Menu">☰</summary>
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={waLink({ page: current })} target="_blank" rel="noopener">WhatsApp us</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>
