---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { service: CollectionEntry<'services'> }
const { service } = Astro.props;
const { name, summary, heroImage, heroAlt } = service.data;
---
<a class="card service-card" href={`/${service.id}`}>
  {heroImage ? (
    <Image src={heroImage} alt={heroAlt} widths={[400, 700]} sizes="(min-width: 960px) 360px, (min-width: 640px) 50vw, 100vw" format="webp" quality={70} />
  ) : (
    <div class="placeholder">Photo coming soon</div>
  )}
  <div class="body">
    <h3>{name}</h3>
    <p class="muted">{summary}</p>
    <span class="more">See {name.toLowerCase()} →</span>
  </div>
</a>
